<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark everywhere, so no white flash before the game draws. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/nc_background</item>
    </style>

    <!-- Theme applied by Capacitor's BridgeActivity once the activity is created. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/nc_background</item>
        <item name="android:colorBackground">@color/nc_background</item>
    </style>

    <!-- Launch (starting window) theme. Android 12+: system splash with the vector emblem on the
         game background. Older versions: launch_background (background + centred splash.png). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nc_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:background">@null</item>
    </style>
</resources>
