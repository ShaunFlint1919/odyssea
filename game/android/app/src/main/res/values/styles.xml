<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window bases. values-v28/styles.xml redefines them with the display-cutout mode, so every
         theme below lays out under the notch (index.html keeps the game box in the safe area). -->
    <style name="Base.NovaCorsair" parent="Theme.AppCompat.NoActionBar" />
    <style name="Base.NovaCorsair.Launch" parent="Theme.SplashScreen" />

    <!-- Base application theme: dark everywhere, so no white flash before the game draws. -->
    <style name="AppTheme" parent="Base.NovaCorsair">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/nc_background</item>
    </style>

    <!-- Theme applied by Capacitor's BridgeActivity (and the splash screen library) once the
         activity is created. -->
    <style name="AppTheme.NoActionBar" parent="Base.NovaCorsair">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/nc_background</item>
        <item name="android:colorBackground">@color/nc_background</item>
    </style>

    <!-- Launch (starting window) theme, set on MainActivity in the manifest. MainActivity calls
         SplashScreen.installSplashScreen() and keeps the splash until the game page has loaded.
         Android 12+: system splash with the vector emblem on the game background. Older versions:
         launch_background (background + centred splash.png). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Base.NovaCorsair.Launch">
        <item name="windowSplashScreenBackground">@color/nc_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:background">@null</item>
    </style>
</resources>
