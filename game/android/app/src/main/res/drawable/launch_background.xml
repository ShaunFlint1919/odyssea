<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: solid game background + the splash emblem centred at its
     native size (never stretched, whatever the screen aspect ratio). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/nc_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash" />
    </item>
</layer-list>
