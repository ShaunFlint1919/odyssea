{
  "name": "nova-corsair",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nova Corsair — high-pace vertical scrolling space shooter (web + Android via Capacitor)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screens": "node tools/screens.mjs",
    "smoke": "node tools/smoke.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "playwright": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
